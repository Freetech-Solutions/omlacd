FROM debian:bullseye

ENV AWS_CLI_VERSION 1.18.5
ENV ANSIBLE_VERSION 2.9.2

ARG DEBIAN_FRONTEND=noninteractive
RUN apt update

RUN apt -y install ruby-dev \
    build-essential && \
    gem i fpm -f

RUN apt update && \
    apt install -y git \
    curl \
    wget \
    subversion \
    libnewt-dev \
    libssl-dev \
    libncurses5-dev \
    subversion \
    libsqlite3-dev \
    libjansson-dev \
    libxml2-dev \
    uuid-dev \
    unixodbc \
    libedit-dev \
    pkg-config \
    libcurl4-openssl-dev \
    libpq-dev \
    unixodbc-dev \
    libgsm1-dev \
    python3-pip \
    python3-venv

RUN pip3 install "awscli==$AWS_CLI_VERSION"
RUN pip3 install --upgrade pip
RUN pip3 install "ansible==$ANSIBLE_VERSION" --user
