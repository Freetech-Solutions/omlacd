[Unit]
Description=Asterisk
After=syslog.target network-online.target

[Service]
Type=forking
User=omnileads
EnvironmentFile=/etc/omnileads/asterisk.env
Environment=USER=omnileads
LimitNOFILE=infinity
ExecStartPre=/bin/bash -c 'source /etc/asterisk/virtualenv/bin/activate'
ExecStart=/usr/sbin/asterisk -U $USER -G $USER -g
ExecReload=/usr/sbin/asterisk -x 'core restart gracefully'
ExecStop=/usr/sbin/asterisk -x 'core stop now'
PIDFile=/var/run/asterisk/asterisk.pid
RuntimeDirectory=asterisk
RuntimeDirectoryMode=755
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
