[Unit]
Description=Asterisk Reloader -Component of The Open Source Contact Center Solution
Documentation= http://www.omnileads.net
After=syslog.target network-online.target

[Service]
Type=simple
User=omnileads
EnvironmentFile=/etc/profile.d/omnileads_envars.sh
ExecStartPre=/bin/bash -c 'source /opt/omnileads/asterisk/virtualenv/bin/activate'
ExecStart=/opt/omnileads/asterisk/virtualenv/bin/python3 /opt/omnileads/asterisk/virtualenv/regenerar_asterisk.py
ExecStop=/usr/bin/pkill -f "python3 regenerar_asterisk.py"
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
