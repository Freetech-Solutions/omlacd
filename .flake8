[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    build,
    docs,
    *.pyc,
    .venv,
    venv,
    env,
    .eggs,
    *.egg-info
# Ignorar códigos de error:
# E203: whitespace before ':'
# E501: line too long (handled by max-line-length)
# W503: line break before binary operator
# F401: imported but unused (sometimes needed for type checking)
ignore =
    E203,
    E501,
    W503,
    F401
per-file-ignores =
    __init__.py:F401
max-complexity = 15

